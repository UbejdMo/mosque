# Copy to .env — never commit .env.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml (host port 5433 to stay clear of any
# Postgres already installed on 5432). Swap for the Supabase EU pooler URL when
# deploying.
DATABASE_URL=postgres://mosque:mosque@localhost:5433/mosque

# The test database — used by the golden-case suite only, and truncated freely.
TEST_DATABASE_URL=postgres://mosque:mosque@localhost:5434/mosque_test

# Where the SPA is served from, for CORS + cookies.
WEB_ORIGIN=http://localhost:5173

# Signs session cookies. Generate a real one for any deployed environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars-long
SESSION_TTL_DAYS=30

# `lax` works when the API and SPA share a registrable domain. Different sites
# need `none`, which browsers only accept with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Defaults to true in production.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

LOG_LEVEL=debug
